<IfModule mod_rewrite.c>
    RewriteEngine On

    # Keep direct requests to /public working while canonicalizing visible URLs.
    RewriteCond %{THE_REQUEST} \s/+public/([^\s?]*) [NC]
    RewriteRule ^public/(.*)$ /$1 [R=301,L]

    # Serve existing files and directories inside /public.
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -d
    RewriteRule ^(.*)$ public/$1 [L]

    # Send everything else to Laravel's front controller.
    RewriteRule ^(.*)$ public/index.php [L]
</IfModule>
